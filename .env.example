# Frontend (Vite) — copy to .env.local for local development.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Production values live in the Vercel project environment settings.

# Google Analytics 4 measurement ID (optional — analytics is skipped if unset)
VITE_GA_ID=G-NZ2WJ2KQMH

# Backend API base URL (optional — defaults to relative "/api")
# Local backend:  VITE_API_URL=http://localhost:5000/api
# Vercel rewrites /api/* to the serverless backend, so production builds
# normally leave this unset.
VITE_API_URL=
