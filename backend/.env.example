# Backend (Express) — copy to backend/.env and fill in real values.
# backend/.env is gitignored; NEVER commit it or paste keys into code/scripts.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database — "memory" uses an in-memory MongoDB (no install needed),
# or a real URI / MongoDB Atlas connection string
MONGO_URI=memory
# MONGO_URI=mongodb://localhost:27017/cinematic-streaming

# TMDB API (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
